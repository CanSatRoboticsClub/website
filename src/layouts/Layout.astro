---
import "../styles/global.css"

interface Props {
    title: string;
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
        <link 
            href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" 
            rel="stylesheet" /> 
        <title>{title}</title>
	</head>
	<!-- Cloudflare Web Analytics -->
	<script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "b4099b19a2044077bc067b37026a8316"}'>
	</script>
	<!-- End Cloudflare Web Analytics -->
	<body>
		<slot />
	</body>
</html>

<style>
	/* min-height, not height: a fixed 100% height caps body at one screen, which
	   stops a sticky navbar from staying pinned further down a long page. */
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
